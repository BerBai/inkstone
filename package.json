{
  "name": "inkstone",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "A minimal bilingual Hugo theme for longreads. Tailwind v4 + 25 built-in shortcodes.",
  "homepage": "https://github.com/BerBai/inkstone",
  "repository": {
    "type": "git",
    "url": "https://github.com/BerBai/inkstone.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "hugo server -s exampleSite --themesDir ../..",
    "build": "hugo --gc --minify -s exampleSite --themesDir ../.. && node scripts/subset-fonts.mjs exampleSite/public",
    "clean": "rm -rf exampleSite/public exampleSite/public-0.128 exampleSite/resources resources public tests/.work",
    "test": "tests/validate.sh"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "pagefind": "^1.4.0",
    "tailwindcss": "^4.0.0"
  }
}
